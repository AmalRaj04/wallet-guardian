# 🛡️ WALLET GUARDIAN - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED - Wallet Connection
# ============================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ============================================
# REQUIRED - AI Analysis
# ============================================
GROQ_API_KEY=your_groq_api_key
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# ============================================
# REQUIRED - Blockchain Data
# ============================================
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_API_KEY=your_alchemy_api_key
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ============================================
# REQUIRED - Price Data
# ============================================
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key
COINGECKO_API_KEY=your_coingecko_api_key
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# ============================================
# OPTIONAL - Additional Services
# ============================================
NEXT_PUBLIC_BLOCKSCOUT_API_KEY=https://eth-sepolia.blockscout.com/api
NEXT_PUBLIC_BLOCKSCOUT_API_URL=https://eth-sepolia.blockscout.com/api/v2
NEXT_PUBLIC_ENVIO_API_KEY=your_envio_api_key
LIT_RELAY_API_KEY=your_lit_api_key
NEXT_PUBLIC_1INCH_API_KEY=your_1inch_api_key
GEMINI_API_KEY=your_gemini_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# ============================================
# OPTIONAL - Database (if using CoinScope features)
# ============================================
DATABASE_URL=your_database_url
AUTH_SECRET=your_auth_secret
AUTH_URL=http://localhost:4000

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_DEBUG=false
