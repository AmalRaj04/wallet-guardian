## Example environment variables for apps/web
# Copy this file to `.env.local` and fill in real values. Do NOT commit your real secrets.

## Server-side (secret) keys - keep these private
# GROQ AI API (server-side) - your Groq endpoint and key used by the server proxy
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
# Database connection used by server-side APIs (Neon / Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth secret used by Auth.js / @auth/core on the server
AUTH_SECRET=398340112342bfed253ebe4c4946e3680155c8ee486d5889a29276dade2db988f9377908422656005dd0f8d39971343d
# Base URL used by auth cookie logic (should include protocol)
AUTH_URL=http://localhost:4000

# Optional: CORS origins for the dev server (comma-separated)
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

## Create (create.xyz) / Stripe / internal API keys (server-side)
# If you integrate with the Create backend, these are used for forwarding requests
NEXT_PUBLIC_PROJECT_GROUP_ID=your-project-group-id
CREATE_TEMP_API_KEY=your-create-temp-api-key
NEXT_PUBLIC_CREATE_BASE_URL=https://www.create.xyz
NEXT_PUBLIC_CREATE_API_BASE_URL=https://www.create.xyz
NEXT_PUBLIC_CREATE_HOST=app.create.xyz

## Public (safe to expose) keys - prefix with NEXT_PUBLIC_
# WalletConnect project id (public) used by client-side wallet connections
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=test-project-id

# Public Blockscout / explorer URL (optional) used by the dashboard UI
NEXT_PUBLIC_BLOCKSCOUT_API_URL=https://eth-sepolia.blockscout.com/api/v2

## RPC / Chain specific (sensitive - RPC keys may be private)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key
SEPOLIA_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY

## Optional environment switches
# Set to PRODUCTION in production builds
NEXT_PUBLIC_CREATE_ENV=DEVELOPMENT

# Any other secrets used by provider integrations should be added here.
